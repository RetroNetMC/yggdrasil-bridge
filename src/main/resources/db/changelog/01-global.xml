<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <property name="db_uuid_type" value="uuid" dbms="postgresql, h2"/>
    <property name="db_uuid_type" value="uniqueidentifier" dbms="mssql"/>
    <property name="db_uuid_type" value="binary(16)" dbms="mysql, mariadb"/>

    <changeSet id="0-create-table-users" author="czompo.david">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_users"/>
            </column>
            <column name="uuid" type="${db_uuid_type}">
                <constraints unique="true" uniqueConstraintName="uc_users_uuid"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="password" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>

    <changeSet id="1-create-table-game_sessions" author="czompo.david">
        <createTable tableName="game_sessions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_game_sessions"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_game_sessions_user" referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
            <column name="status" type="VARCHAR(16)"/>
            <column name="access_token" type="VARCHAR(255)"/>
            <column name="client_token" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
            <column name="expires_at" type="DATETIME"/>
        </createTable>
    </changeSet>

</databaseChangeLog>