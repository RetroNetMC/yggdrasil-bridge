<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="0-create-table-users" author="czompo.david">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true" incrementBy="1">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_users"/>
            </column>
            <column name="uuid" type="UUID">
                <constraints unique="true" uniqueConstraintName="uc_users_uuid" />
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="username" type="VARCHAR(16)"/>
            <column name="password" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>

    <changeSet id="1-create-table-user_properties" author="czompo.david">
        <createTable tableName="user_properties">
            <column name="id" type="BIGINT" autoIncrement="true" incrementBy="1">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_properties"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints foreignKeyName="fk_user_properties_user" referencedColumnNames="id" referencedTableName="users"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="value" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="2-create-table-textures" author="czompo.david">
        <createTable tableName="textures">
            <column name="id" type="BIGINT" autoIncrement="true" incrementBy="1">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_textures"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_textures_user" referencedTableName="users" referencedColumnNames="id"/>
            </column>
            <column name="type" type="SMALLINT"/>
            <column name="url" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>

    <changeSet id="3-create-table-texture_metadata" author="czompo.david">
        <createTable tableName="texture_metadata">
            <column name="id" type="BIGINT" autoIncrement="true" incrementBy="1">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_texture_metadata"/>
            </column>
            <column name="texture_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_texture_metadata_texture" referencedTableName="textures" referencedColumnNames="id"/>
            </column>
            <column name="key" type="VARCHAR(255)"/>
            <column name="value" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>

    <changeSet id="4-create-table-sessions" author="czompo.david">
        <createTable tableName="sessions">
            <column name="id" type="BIGINT" autoIncrement="true" incrementBy="1">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_sessions"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_sessions_user" referencedTableName="users" referencedColumnNames="id"/>
            </column>
            <column name="status" type="VARCHAR(16)"/>
            <column name="access_token" type="VARCHAR(255)"/>
            <column name="client_token" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
            <column name="expires_at" type="DATETIME"/>
        </createTable>
    </changeSet>

</databaseChangeLog>